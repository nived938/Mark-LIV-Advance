# J.A.R.V.I.S. local API configuration
# Copy this file to .env and replace the blank values with your own credentials.
# Never commit .env.

# Gemini
GEMINI_API_KEY=

# Caldays — no API key required
CALDAYS_BASE_URL=https://caldays.com/api

# Gofile
GOFILE_API_TOKEN=
GOFILE_API_BASE_URL=https://api.gofile.io
GOFILE_UPLOAD_URL=https://upload.gofile.io/uploadfile
GOFILE_DOWNLOAD_DIR=downloads

# Chess.com Published Data API — no API key required
CHESS_BASE_URL=https://api.chess.com/pub
# Use a recognizable user-agent with contact information.
CHESS_USER_AGENT=JARVIS/1.0 (contact: your-email@example.com)

# IPstack
IPSTACK_API_KEY=
# The current IPstack free plan documents HTTP access; HTTPS is available on paid plans.
IPSTACK_BASE_URL=http://api.ipstack.com

# MassiveMusic / 7digital
MASSIVEMUSIC_BASE_URL=https://api.7digital.com
MASSIVEMUSIC_CONSUMER_KEY=
MASSIVEMUSIC_COUNTRY=IN
MASSIVEMUSIC_USAGE_TYPES=subscriptionstreaming

# Kavel — keyless anonymous generation works without a key.
# Add a key only if you want to use your own Kavel account/credits.
KAVEL_API_KEY=
KAVEL_MODEL=
